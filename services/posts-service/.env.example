# Local dev default (docker-compose maps posts-postgres -> localhost:5443).
# Inside docker-compose, this is overridden to:
#   postgresql+psycopg://posts:posts@posts-postgres:5432/posts_db
DATABASE_URL=postgresql+psycopg://posts:posts@localhost:5443/posts_db

# Origin of the API gateway, for CORS.
GATEWAY_ORIGIN=http://localhost:8080

# OpenTelemetry OTLP/HTTP traces endpoint (Jaeger collector).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
