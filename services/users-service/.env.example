# Local dev default (docker compose maps external 5442 -> the users-postgres container's 5432)
DATABASE_URL=postgresql+psycopg://users:users@localhost:5442/users_db

# In docker-compose, this becomes: postgresql+psycopg://users:users@users-postgres:5432/users_db

# Origin of the API gateway allowed to call this service via CORS
GATEWAY_ORIGIN=http://localhost:5000

# OTLP HTTP endpoint for trace export (Jaeger collector). Safe to leave
# unreachable in local dev -- the exporter fails silently in the background.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# Logical service name reported in traces
OTEL_SERVICE_NAME=users-service
