# --- Auth / JWT ---
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# --- Local gateway auth DB (credentials only; separate from users-service's business data) ---
# Defaults to a local SQLite file for dev. Point at Postgres in compose/production, e.g.:
# GATEWAY_DB_URL=postgresql+psycopg://gateway:gateway@postgres:5432/gateway_auth
GATEWAY_DB_URL=sqlite:///gateway_auth.db

# --- Downstream microservices ---
USERS_SERVICE_URL=http://localhost:8101
POSTS_SERVICE_URL=http://localhost:8102

# --- Circuit breaker ---
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_RECOVERY_TIMEOUT=30
DOWNSTREAM_TIMEOUT_SECONDS=5

# --- Redis (rate limiting) ---
# Local dev defaults to localhost:6379 (docker-compose maps host 6390 -> container 6379,
# but INSIDE the compose network the gateway must use the service alias/port below).
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# In docker-compose:
# REDIS_HOST=redis
# REDIS_PORT=6379

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=api-gateway
LOG_LEVEL=INFO

# --- CORS ---
CORS_ORIGINS=*

# --- Flask ---
FLASK_ENV=production
PORT=8000
